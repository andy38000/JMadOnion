// --------------- 基础路径 ---------------
global string $address;
$address = "Z:/rig/A/RigTools/";

// --------------- 辅助函数：生成 source 命令字符串 ---------------
//  用法：srcCmd("子路径/文件.mel")  →  返回  source "Z:/rig/A/RigTools/子路径/文件.mel"
global proc string srcCmd(string $relPath)
{
    global string $address;
    return ("source \"" + $address + $relPath + "\"");
}

