// ======================== 帮助窗口 ========================
global proc helpInfo()
{
    if (`window -ex helpInfoWindow`) deleteUI helpInfoWindow;
    window -t "关于RigTools" helpInfoWindow;
    columnLayout -adj 1 catch_columnLayout;
    text -l ("\n美术部门Rig快捷栏 v3.1\n\n"
           + "更新日期：2023.07.27\n\n"
           + "作者：初六\n需要帮助请联系我\n\n"
           + "本次添加：N20加控制器\n\n"
           + " chuliu@bytedance.com\n\n"
           + "(C)  ∞ thankyou！");
    showWindow helpInfoWindow;
}

// ======================== userSetup 自动注册 ========================
global proc SETUPTools()
{
    string $scriptPath    = `internalVar -userScriptDir`;
    string $userSetupPath = $scriptPath + "userSetup.mel";
    string $thePaths      = "Y:/RigTools/SETUPTools.mel";
    string $tag           = "//设置工具栏;\n";
    string $block         = ("\n" + $tag + "source \"" + $thePaths + "\";\n\n");

    if (!`filetest -f $userSetupPath`)
    {
        $suf = `fopen $userSetupPath "w"`;
        fprint $suf ("\n//RigTools;\n");
        fprint $suf ("source \"" + $thePaths + "\";\n\n");
        fclose $suf;
    }
    else
    {
        // 检查是否已经注册过
        int $found = 0;
        $suf = `fopen $userSetupPath "r"`;
        string $line = `fgetline $suf`;
        while (size($line) > 0)
        {
            if (size($line) != 1 && `gmatch $line $tag`)
                $found = 1;
            $line = `fgetline $suf`;
        }
        fclose $suf;

        if (!$found)
        {
            $suf = `fopen $userSetupPath "a"`;
            fprint $suf $block;
            fclose $suf;
        }
    }
}

SETUPTools();
// ======================== end ========================
